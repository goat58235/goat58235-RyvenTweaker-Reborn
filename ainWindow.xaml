
<Window x:Class="RyvenTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RYVEN TWEAKER"
        Height="760"
        Width="1180"
        MinHeight="620"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="RYVEN"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="TWEAKER  /  GAMING PERFORMANCE"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="2,0,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#FF302640"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="SYSTEM STATUS"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="StatusText"
                               Text="INITIALIZING"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hardware summary -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#FF302640"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="PROCESSOR"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"/>
                    <TextBlock x:Name="CpuText"
                               Text="Detecting CPU..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,6,8,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="GRAPHICS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"/>
                    <TextBlock x:Name="GpuText"
                               Text="Detecting GPU..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,6,8,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="MEMORY"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"/>
                    <TextBlock x:Name="RamText"
                               Text="Detecting RAM..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,6,8,0"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="SCAN PC"
                        VerticalAlignment="Center"
                        Click="ScanButton_Click"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="#FF302640"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="OPTIMIZATION"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="4,4,4,14"/>

                    <Button Content="Overview"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Click="OverviewButton_Click"/>

                    <Button Content="Windows"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Click="WindowsButton_Click"/>

                    <Button Content="CPU &amp; RAM"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Click="HardwareButton_Click"/>

                    <Button Content="GPU"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Click="GpuButton_Click"/>

                    <Button Content="Network"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Click="NetworkButton_Click"/>

                    <Button Content="Input &amp; Mouse"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Click="InputButton_Click"/>

                    <Button Content="Game Profiles"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Click="GamesButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Main panel -->
            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#FF302640"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="PageTitle"
                                   Text="Performance Center"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="PageDescription"
                                   Text="Discover your hardware and manage compatible tweaks."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBox x:Name="SearchBox"
                             Grid.Row="1"
                             Height="38"
                             Margin="0,18,0,14"
                             Padding="10,8"
                             Background="#FF0D0D15"
                             Foreground="White"
                             BorderBrush="#FF40334F"
                             CaretBrush="White"
                             TextChanged="SearchBox_TextChanged"
                             VerticalContentAlignment="Center"/>

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="EmptyStateText"
                                   Text="Your optimization tools will appear here."
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="20"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TweakList"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="RYVEN TWEAKER  •  BUILT FOR PERFORMANCE"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       VerticalAlignment="Center"/>

            <TextBlock Text="Changes may require a restart"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
