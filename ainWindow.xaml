
<Window x:Class="RyvenTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RYVEN TWEAKER"
        Height="780"
        Width="1200"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#09090F"
        Foreground="#F4F0FF">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#13121D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#9B5CFF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A6A0B8"/>
        <SolidColorBrush x:Key="LineBrush" Color="#292438"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F0FF"/>
            <Setter Property="Background" Value="#201A30"/>
            <Setter Property="BorderBrush" Value="#403056"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <DataTemplate x:Key="TweakCardTemplate">
            <Border Background="#13121D"
                    BorderBrush="#292438"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding Risk}"
                                   Foreground="#C49AFF"
                                   HorizontalAlignment="Right"
                                   Margin="12,2,0,0"/>
                    </DockPanel>

                    <TextBlock Text="{Binding Description}"
                               Foreground="#B9B2CC"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding ExpectedBenefit}"
                               Foreground="#D8C8FF"
                               Margin="0,0,0,8"/>

                    <DockPanel>
                        <TextBlock Text="{Binding Category}"
                                   Foreground="#9B93AC"/>
                        <TextBlock Text="{Binding Status}"
                                   Foreground="#B78AFF"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.ColumnSpan="2"
                Background="#13121D"
                BorderBrush="#292438"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="RYVEN"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#B78AFF"/>
                    <TextBlock Text="COMPETITIVE PERFORMANCE CENTER"
                               FontSize="11"
                               Foreground="#A6A0B8"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusText"
                               Text="READY"
                               Foreground="#B78AFF"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                    <Button Content="SCAN HARDWARE"
                            Click="ScanButton_Click"
                            Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SIDEBAR -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#13121D"
                BorderBrush="#292438"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,0,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WORKSPACE"
                               Foreground="#827991"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="4,4,0,12"/>

                    <Button Content="Overview"
                            Click="OverviewButton_Click"/>
                    <Button Content="Windows"
                            Click="WindowsButton_Click"/>
                    <Button Content="CPU &amp; RAM"
                            Click="HardwareButton_Click"/>
                    <Button Content="GPU"
                            Click="GpuButton_Click"/>
                    <Button Content="Network"
                            Click="NetworkButton_Click"/>
                    <Button Content="Input &amp; Mouse"
                            Click="InputButton_Click"/>
                    <Button Content="Gaming"
                            Click="GamesButton_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            Margin="4,20,4,4">
                    <TextBlock Text="DETECTED HARDWARE"
                               Foreground="#B78AFF"
                               FontWeight="Bold"
                               FontSize="11"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="PROCESSOR"
                               Foreground="#827991"
                               FontSize="10"/>
                    <TextBlock x:Name="CpuText"
                               Text="Not scanned"
                               Margin="0,3,0,10"/>

                    <TextBlock Text="GRAPHICS"
                               Foreground="#827991"
                               FontSize="10"/>
                    <TextBlock x:Name="GpuText"
                               Text="Not scanned"
                               Margin="0,3,0,10"/>

                    <TextBlock Text="MEMORY"
                               Foreground="#827991"
                               FontSize="10"/>
                    <TextBlock x:Name="RamText"
                               Text="Not scanned"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="2,0,2,16">
                <TextBlock x:Name="PageTitle"
                           Text="Performance Center"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"/>

                <TextBlock x:Name="PageDescription"
                           Text="Your dashboard for gaming performance and optimization."
                           Foreground="#A6A0B8"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <TextBox x:Name="SearchBox"
                     Grid.Row="1"
                     Height="40"
                     Padding="12,8"
                     FontSize="14"
                     Background="#13121D"
                     Foreground="#FFFFFF"
                     BorderBrush="#403056"
                     CaretBrush="#B78AFF"
                     TextChanged="SearchBox_TextChanged"
                     Margin="0,0,0,14"
                     ToolTip="Search tweaks"/>

            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TweakList"
                                  ItemTemplate="{StaticResource TweakCardTemplate}"/>
                </ScrollViewer>

                <TextBlock x:Name="EmptyStateText"
                           Text="No tweaks available in this category."
                           Foreground="#A6A0B8"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
