<Window x:Class="RyvenTweaker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RYVEN  |  Performance Studio" Width="1320" Height="840" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#090911" Foreground="#F4F1FC" FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#141320"/>
  <SolidColorBrush x:Key="Line" Color="#30283F"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#241B36"/><Setter Property="Foreground" Value="#EDE4FF"/><Setter Property="BorderBrush" Value="#44335D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,3"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#49316D"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <DataTemplate x:Key="TweakCardTemplate">
   <Border Background="#181624" BorderBrush="#322940" BorderThickness="1" CornerRadius="12" Margin="0,0,0,11" Padding="18">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
     <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="16"/><Border Background="#342448" CornerRadius="5" Margin="12,0,0,0" Padding="7,3"><TextBlock Text="{Binding Risk}" Foreground="#CEB0FF" FontSize="11"/></Border></StackPanel><TextBlock Text="{Binding Description}" Foreground="#B2A8C3" Margin="0,9,0,6" FontSize="12"/><TextBlock Text="{Binding ExpectedBenefit}" Foreground="#8C80A3" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{Binding Category}" Foreground="#AB8AF0" FontSize="11"/><TextBlock Text="  •  " Foreground="#6F6580"/><TextBlock Text="{Binding Status}" Foreground="#D1B5FF" FontSize="11"/></StackPanel></StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"><Button Content="APPLY" Tag="{Binding Id}" Click="Apply_Click" Background="#6538AE" BorderBrush="#8E5CE3"/><Button Content="UNDO" Tag="{Binding Id}" Click="Undo_Click"/></StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#11101B" BorderBrush="#2D253C" BorderThickness="0,0,1,0" Padding="20"><DockPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Background="#1E192B" CornerRadius="10" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="SYSTEM STATUS" Foreground="#A78FCF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="READY" Foreground="#C8A6FF" FontSize="13" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border><TextBlock Text="RYVEN  /  V3 PREVIEW" Foreground="#726783" FontSize="10"/></StackPanel>
   <StackPanel><TextBlock Text="RYVEN" Foreground="#E7D6FF" FontSize="31" FontWeight="Bold"/><TextBlock Text="PERFORMANCE STUDIO" Foreground="#A98AD3" FontSize="10" Margin="1,0,0,34"/><TextBlock Text="WORKSPACE" Foreground="#766B8B" FontSize="10" FontWeight="Bold" Margin="4,0,0,12"/><Button Content="◈    Overview" Click="OverviewButton_Click"/><Button Content="▣    Windows" Click="WindowsButton_Click"/><Button Content="◉    CPU &amp; RAM" Click="HardwareButton_Click"/><Button Content="▧    GPU" Click="GpuButton_Click"/><Button Content="⌁    Network" Click="NetworkButton_Click"/><Button Content="⊙    Input" Click="InputButton_Click"/><Button Content="◇    Gaming" Click="GamesButton_Click"/><Border Height="1" Background="#322940" Margin="0,24"/><TextBlock Text="SAFE BY DESIGN" Foreground="#BD9CE9" FontSize="11" FontWeight="Bold"/><TextBlock Text="Review each change. Backups are session-only in this build." Foreground="#8E829F" FontSize="12" Margin="0,9,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,22,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PERFORMANCE / DASHBOARD" Foreground="#A38CBF" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="Performance Center" FontSize="29" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/><TextBlock x:Name="PageDescription" Text="Your system. Your settings." Foreground="#A89DB9" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="↻  SCAN HARDWARE" Click="ScanButton_Click" VerticalAlignment="Center" Padding="18,12"/></Grid>
   <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#191626" BorderBrush="#352942" BorderThickness="1" CornerRadius="12" Padding="15"><StackPanel><TextBlock Text="PROCESSOR" Foreground="#9F87C5" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CpuText" Text="Not scanned" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Grid.Column="2" Background="#191626" BorderBrush="#352942" BorderThickness="1" CornerRadius="12" Padding="15"><StackPanel><TextBlock Text="GRAPHICS" Foreground="#9F87C5" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="GpuText" Text="Not scanned" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Grid.Column="4" Background="#191626" BorderBrush="#352942" BorderThickness="1" CornerRadius="12" Padding="15"><StackPanel><TextBlock Text="MEMORY" Foreground="#9F87C5" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="RamText" Text="Not scanned" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border>
   </Grid>
   <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TWEAK LIBRARY" Foreground="White" FontWeight="Bold" FontSize="17"/><TextBlock Text="Selective Windows adjustments  •  No guaranteed FPS gains" Foreground="#9589A8" FontSize="11" Margin="0,5,0,0"/></StackPanel><TextBox x:Name="SearchBox" Grid.Column="1" Height="38" Padding="12,9" TextChanged="SearchBox_TextChanged" Background="#1B1828" Foreground="White" CaretBrush="#BC94FF" BorderBrush="#4B3A62" ToolTip="Search tweaks"/></Grid><Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="TweakList" ItemTemplate="{StaticResource TweakCardTemplate}"/></ScrollViewer><TextBlock x:Name="EmptyStateText" Text="No matching tweaks" Foreground="#AFA3C1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Grid>
  </Grid>
 </Grid>
</Window>
