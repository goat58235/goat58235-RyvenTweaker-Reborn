<Window x:Class="RyvenTweaker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RYVEN | Performance Center" Height="810" Width="1280" MinHeight="680" MinWidth="1020" WindowStartupLocation="CenterScreen" Background="#090A10" Foreground="#F3F0FF" FontFamily="Segoe UI">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Background" Value="#292039"/><Setter Property="Foreground" Value="#F4EFFF"/><Setter Property="BorderBrush" Value="#514066"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,9"/><Setter Property="Margin" Value="0,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,13"/><Setter Property="Background" Value="#171521"/><Setter Property="BorderBrush" Value="#252133"/></Style>
 <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#6F3BC4"/><Setter Property="BorderBrush" Value="#9967E8"/><Setter Property="MinWidth" Value="86"/></Style>
 <DataTemplate x:Key="TweakCardTemplate">
  <Border Background="#171621" BorderBrush="#302A40" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,11">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,18,0">
     <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
     <TextBlock Text="{Binding Description}" Foreground="#ABA5BE" TextWrapping="Wrap" Margin="0,7,0,5"/>
     <TextBlock Text="{Binding ExpectedBenefit}" Foreground="#C7B4E9" FontSize="12" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="{Binding Category}" Foreground="#A59AB8" FontSize="11"/><TextBlock Text="   •   " Foreground="#6C647C"/><TextBlock Text="{Binding Risk}" Foreground="#C49AFF" FontSize="11"/><TextBlock Text="   •   " Foreground="#6C647C"/><TextBlock Text="{Binding Status}" Foreground="#BCA0FF" FontSize="11"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="APPLY" Style="{StaticResource ActionButton}" Tag="{Binding Id}" Click="Apply_Click"/><Button Content="UNDO" Tag="{Binding Id}" Click="Undo_Click"/></StackPanel>
   </Grid>
  </Border>
 </DataTemplate>
</Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="85"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Grid.ColumnSpan="2" Background="#13121D" CornerRadius="12" BorderBrush="#30273F" BorderThickness="1" Padding="20" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="RYVEN" Foreground="#D0B2FF" FontSize="29" FontWeight="Bold" FontFamily="Segoe UI Semibold"/><TextBlock Text="  /  TWEAKER" Foreground="#F1ECFF" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel><TextBlock Text="COMPETITIVE PERFORMANCE CENTER     •     V2" FontSize="10" Foreground="#9087A3"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="StatusText" Text="READY" Foreground="#BCA0FF" HorizontalAlignment="Right" FontWeight="SemiBold"/><Button Content="SCAN HARDWARE" Click="ScanButton_Click" Padding="15,7"/></StackPanel></Grid></Border>
 <Border Grid.Row="1" Grid.Column="0" Background="#12111C" CornerRadius="12" BorderBrush="#30273F" BorderThickness="1" Padding="14" Margin="0,0,14,0"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="5,20,5,8"><TextBlock Text="SYSTEM HARDWARE" Foreground="#B78AFF" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock Text="CPU" Foreground="#827991" FontSize="10"/><TextBlock x:Name="CpuText" Text="Not scanned" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="GPU" Foreground="#827991" FontSize="10"/><TextBlock x:Name="GpuText" Text="Not scanned" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="MEMORY" Foreground="#827991" FontSize="10"/><TextBlock x:Name="RamText" Text="Not scanned" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="WORKSPACE" Foreground="#8D829F" FontSize="11" FontWeight="Bold" Margin="7,6,0,14"/><Button Content="◈   Overview" Style="{StaticResource NavButton}" Click="OverviewButton_Click"/><Button Content="▣   Windows" Style="{StaticResource NavButton}" Click="WindowsButton_Click"/><Button Content="◉   CPU &amp; RAM" Style="{StaticResource NavButton}" Click="HardwareButton_Click"/><Button Content="▧   GPU" Style="{StaticResource NavButton}" Click="GpuButton_Click"/><Button Content="◎   Network" Style="{StaticResource NavButton}" Click="NetworkButton_Click"/><Button Content="⌖   Input &amp; Mouse" Style="{StaticResource NavButton}" Click="InputButton_Click"/><Button Content="▸   Gaming" Style="{StaticResource NavButton}" Click="GamesButton_Click"/></StackPanel></DockPanel></Border>
 <Grid Grid.Row="1" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#171420" CornerRadius="12" Padding="20" BorderBrush="#30273F" BorderThickness="1" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="PageTitle" Text="Performance Center" FontSize="26" FontWeight="Bold" Foreground="White"/><TextBlock x:Name="PageDescription" Text="Real settings with reversible actions" Foreground="#AAA2BA" Margin="0,7,0,0"/><TextBlock Text="Changes are backed up for this session only. Undo before closing. Test tweaks individually." Foreground="#CBA9FF" FontSize="11" Margin="0,13,0,0"/></StackPanel></Border><TextBox x:Name="SearchBox" Grid.Row="1" Height="43" Padding="13,10" Background="#171621" Foreground="White" CaretBrush="#BCA0FF" BorderBrush="#3B3150" FontSize="13" TextChanged="SearchBox_TextChanged" Margin="0,0,0,13" ToolTip="Search tweaks"/><Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="TweakList" ItemTemplate="{StaticResource TweakCardTemplate}"/></ScrollViewer><TextBlock x:Name="EmptyStateText" Text="No tweaks in this category" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAA2BA"/></Grid></Grid>
 <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="RYVEN TWEAKER     /     LOCAL WINDOWS SETTINGS     /     NO GUARANTEED FPS BOOST" Foreground="#706981" VerticalAlignment="Center" FontSize="10" Margin="7,0,0,0"/>
</Grid></Window>
